# Supabase connection for the Tear Sheets app.
# Copy this file to ".env.local" and fill in the two values from your Supabase
# project: Dashboard -> Project Settings -> API.
#
# Only the public "anon" key goes here. It is safe to expose in the browser
# because Row-Level Security (see supabase/migrations) enforces all access.
# NEVER put the service_role key in this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# SERVER-ONLY secrets. NEVER prefix a secret with VITE_ — Vite inlines any
# VITE_* variable into the public browser bundle. These are read only by the
# serverless /api functions via process.env, and must be set in Vercel's
# Environment Variables (and in .env.local for local `npm run dev`).
# ---------------------------------------------------------------------------

# Optional: enables the AI "auto-fill from messy pages / images" tier (Tier 2).
# The free "paste a product link" tier works WITHOUT this key. Usage is billed
# by Anthropic — set a spend cap in the Anthropic Console. Get a key at
# https://console.anthropic.com  →  API Keys.
ANTHROPIC_API_KEY=
